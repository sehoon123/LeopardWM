EXPECTED_BASE = "68ebea44339fb9293b48334ecc081af0b198e069"
RELEASE_TAG = "v0.2.6-sehoon.6"
RELEASE_VERSION = "0.2.6-sehoon.6"
PATCH_SHA256 = "69cd44c1c3b3897d9e3f4f177aaba529568f69d46808c986c35673c7b4f23e6b"
BINARIES = [
    "leopardwm.exe",
